{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(codex exec:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(just switch)",
      "Bash(just switch:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r \".tool_input.command // empty\"); if printf \"%s\" \"$cmd\" | grep -Eq \"codex\" && printf \"%s\" \"$cmd\" | grep -Eiq -- \"--dangerously-bypass|danger-full-access\"; then echo \"blocked: codex sandbox/approval bypass flags are not permitted\" >&2; exit 2; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state off"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state running"
          },
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-option -p -t \"$TMUX_PANE\" @pstate \"\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state needs-input"
          },
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-option -p -t \"$TMUX_PANE\" @pstate needs-input || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state done"
          },
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set-option -p -t \"$TMUX_PANE\" @pstate done || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cship",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "ralph-loop@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "workmux-status@workmux": true,
    "git-surgeon@git-surgeon": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "workmux": {
      "source": {
        "source": "github",
        "repo": "raine/workmux"
      }
    },
    "git-surgeon": {
      "source": {
        "source": "github",
        "repo": "raine/git-surgeon"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "xhigh",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
