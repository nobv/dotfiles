#!/usr/bin/env bash

# Out-of-store symlink into the dotfiles repo. sketchybar has no config watcher,
# so an edit needs `sketchybar --reload`.
#
# The bar lives in the hidden menu bar's strip: macOS excludes that strip from
# visibleFrame even while hidden, so AeroSpace never tiles over it and
# aerospace.toml's gaps.outer.top is just the gap below the bar, not its height.
# Keep BAR_HEIGHT at or under the strip (33px here) or the bar will overhang into
# the tiles.

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

BAR_HEIGHT=32
PILL_HEIGHT=24
PILL_RADIUS=6
FONT="HackGen Console NF" # same as Ghostty; carries Nerd Font glyphs and Japanese

sketchybar --bar \
  position=top \
  height="$BAR_HEIGHT" \
  color="$BAR_BG" \
  padding_left=14 \
  padding_right=6

sketchybar --default \
  icon.font="$FONT:Bold:13.0" \
  label.font="$FONT:Bold:12.0" \
  icon.color="$FG" \
  label.color="$FG" \
  padding_left=0 \
  padding_right=0

PILL_GAP=8

add_gap() {
  sketchybar --add item "$1" "$2"
  sketchybar --set "$1" \
    width="$PILL_GAP" \
    background.drawing=off \
    icon.drawing=off \
    label.drawing=off
}

# A pill is a coloured cap plus a label, with a bracket drawing the body behind
# both — sketchybar cannot round one side of an item, so the cap sits inside the
# bracket. `left` stacks left-to-right and `right` stacks right-to-left, so the
# add order flips to keep the cap on the left.
add_pill() {
  local name="$1" side="$2" icon="$3" cap_color="$4"

  # The cap matches the bracket's height and radius so it reads as the left half
  # of one pill; any smaller and it floats inside as a separate island. Spacing
  # between pills comes from the outer padding on the two end items, since the
  # bracket only wraps what its members occupy.
  local cap_args=(
    icon="$icon"
    icon.color="$CAP_FG"
    icon.padding_left=9
    icon.padding_right=9
    label.drawing=off
    background.color="$cap_color"
    background.corner_radius="$PILL_RADIUS"
    background.height="$PILL_HEIGHT"
    padding_left=0
    padding_right=0
  )
  local label_args=(
    icon.drawing=off
    label.padding_left=9
    label.padding_right=11
    padding_left=0
    padding_right=0
  )

  # An item's own padding lands inside its bracket, and brackets take no padding
  # of their own, so neighbouring pills would butt together into one continuous
  # bar. The gap is a real item, left out of the bracket.
  if [ "$side" = "left" ]; then
    sketchybar --add item "$name.cap" left --set "$name.cap" "${cap_args[@]}"
    sketchybar --add item "$name" left --set "$name" "${label_args[@]}"
    add_gap "$name.gap" left
  else
    add_gap "$name.gap" right
    sketchybar --add item "$name" right --set "$name" "${label_args[@]}"
    sketchybar --add item "$name.cap" right --set "$name.cap" "${cap_args[@]}"
  fi

  sketchybar --add bracket "$name.pill" "$name.cap" "$name" \
    --set "$name.pill" \
    background.color="$PILL" \
    background.corner_radius="$PILL_RADIUS" \
    background.height="$PILL_HEIGHT"
}

# Two lines in one pill. sketchybar has no multi-line item, so the lines are two
# items pushed apart with y_offset; width=0 on the first makes the second start
# at the same x instead of beside it.
add_stacked_pill() {
  local name="$1" icon="$2" cap_color="$3"

  add_gap "$name.gap" right

  sketchybar --add item "$name" right
  sketchybar --set "$name" \
    icon.drawing=off \
    width=0 \
    y_offset=-6 \
    label.font="$FONT:Bold:9.0" \
    label.padding_left=9 \
    label.padding_right=11 \
    padding_left=0 \
    padding_right=0

  sketchybar --add item "$name.top" right
  sketchybar --set "$name.top" \
    icon.drawing=off \
    y_offset=6 \
    label.font="$FONT:Bold:9.0" \
    label.padding_left=9 \
    label.padding_right=11 \
    padding_left=0 \
    padding_right=0

  sketchybar --add item "$name.cap" right
  sketchybar --set "$name.cap" \
    icon="$icon" \
    icon.color="$CAP_FG" \
    icon.padding_left=9 \
    icon.padding_right=9 \
    label.drawing=off \
    background.color="$cap_color" \
    background.corner_radius="$PILL_RADIUS" \
    background.height="$PILL_HEIGHT" \
    padding_left=0 \
    padding_right=0

  sketchybar --add bracket "$name.pill" "$name.cap" "$name.top" "$name" \
    --set "$name.pill" \
    background.color="$PILL" \
    background.corner_radius="$PILL_RADIUS" \
    background.height="$PILL_HEIGHT"
}

##### Left #####

# Polled, not event-driven: the case worth catching is `~/Desk` moving while the
# workspace does not, and an AeroSpace event is silent exactly then.
add_pill desk left "$ICON_DESK" "$PURPLE"
sketchybar --set desk script="$PLUGIN_DIR/desk.sh" update_freq=1

add_pill front_app left "$ICON_APP" "$COMMENT"
sketchybar --set front_app script="$PLUGIN_DIR/front_app.sh"
sketchybar --subscribe front_app front_app_switched

##### Right — added right-to-left #####

add_pill clock right "$ICON_CLOCK" "$COMMENT"
sketchybar --set clock script="$PLUGIN_DIR/clock.sh" update_freq=10

add_stacked_pill battery "$ICON_BATT" "$YELLOW"
sketchybar --set battery script="$PLUGIN_DIR/battery.sh" update_freq=60
sketchybar --subscribe battery system_woke power_source_change

# Slow because each reading costs macmon ~1.2s of setup.
add_pill temp right "$ICON_TEMP" "$ORANGE"
sketchybar --set temp script="$PLUGIN_DIR/temp.sh" update_freq=30

add_pill cpu right "$ICON_CPU" "$GREEN"
sketchybar --set cpu script="$PLUGIN_DIR/cpu.sh" update_freq=2

add_pill memory right "$ICON_MEM" "$CYAN"
sketchybar --set memory script="$PLUGIN_DIR/memory.sh" update_freq=2

add_pill meeting right "$ICON_CAL" "$PINK"
sketchybar --set meeting script="$PLUGIN_DIR/meeting.sh" update_freq=30

sketchybar --update
