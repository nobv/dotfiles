#!/usr/bin/env bash

# Out-of-store symlink into the dotfiles repo. `just nix switch` restarts the
# running instance for you (modules/system/borders/default.nix); editing this
# file directly without switching needs a manual re-run of `borders` with the
# new options — a running instance picks them up.
#
# Only the focused window is outlined. AeroSpace tiles, so every window's edge is
# already obvious — drawing all of them would just add lines. Colours follow the
# same Dracula palette as sketchybar (purple, matching the desk pill).
#
# The width was settled by eye. Note it exceeds gaps.inner (10) in aerospace.toml,
# so adjacent windows' borders meet.

options=(
  style=round
  width=11.0
  hidpi=on
  active_color=0xffbd93f9
  inactive_color=0x00000000
)

borders "${options[@]}"
